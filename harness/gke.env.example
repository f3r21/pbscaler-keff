# ─────────────────────────────────────────────────────────────────────
# GKE experiment cluster — shared configuration (EXAMPLE)
# Copy to `gke.env` and fill in PROJECT_ID before running any script.
# `gke.env` is git-ignored (it holds your own GCP project id).
#   cp harness/gke.env.example harness/gke.env
# Source it from setup_gke.sh and teardown_gke.sh.
# ─────────────────────────────────────────────────────────────────────

# ⚠  YOU MUST SET THIS before running any script (your own GCP project).
PROJECT_ID="<your-gcp-project-id>"

# Cluster
CLUSTER_NAME="pbscaler-experiment"
ZONE="us-central1-a"
MACHINE_TYPE="e2-standard-4"
NUM_NODES=3
CLUSTER_VERSION="1.35.3-gke.1389000"   # versión EXACTA de los 24 runs (cross-comparabilidad); estática (--no-enable-autoupgrade)
DISK_SIZE=50                           # 3×50=150 GB SSD. NO afecta métricas (workload no es disk-bound); Prometheus usa emptyDir

# Istio
ISTIO_VERSION="1.24.3"

# Namespaces
APP_NAMESPACE="online-boutique"
MON_NAMESPACE="monitoring"

# Helm release name for kube-prometheus-stack
PROM_RELEASE="prometheus-stack"

# Paths (relative to project root)
BOUTIQUE_MANIFESTS="benchmarks/microservices-demo/kubernetes-manifests"
ISTIO_MANIFESTS="benchmarks/microservices-demo/istio-manifests"
